<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PIPZ – Karyawan Digital untuk Praktik Mata</title>
<style>
:root{--bg:#f7f9fc;--card:#fff;--ink:#14213d;--muted:#5b6b82;--brand:#2563eb;--brand2:#1e40af;--ok:#16a34a;--bad:#dc2626;--line:#e3e9f2}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
section{padding:56px 0}
h2{font-size:1.7rem;text-align:center;margin-bottom:8px}
.sub{text-align:center;color:var(--muted);margin-bottom:32px}
/* Hero */
.hero{text-align:center;padding:72px 0 56px;background:linear-gradient(180deg,#eaf1ff,var(--bg))}
.avatar{width:96px;height:96px;margin:0 auto 18px;border-radius:50%;background:linear-gradient(135deg,var(--brand),#60a5fa);display:flex;align-items:center;justify-content:center;font-size:3rem;box-shadow:0 10px 30px rgba(37,99,235,.3)}
.hero h1{font-size:2.8rem;letter-spacing:2px}
.badge{display:inline-block;margin:14px 0;padding:6px 16px;background:#e8f7ee;color:var(--ok);border:1px solid #bfe8cf;border-radius:999px;font-weight:600;font-size:.9rem;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(22,163,74,.35)}50%{box-shadow:0 0 0 8px rgba(22,163,74,0)}}
.tagline{max-width:600px;margin:0 auto;color:var(--muted);font-size:1.15rem}
/* Problem & Solution */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.box{background:var(--card);border-radius:16px;padding:26px;border:1px solid var(--line);box-shadow:0 4px 14px rgba(20,33,61,.05)}
.box h3{margin-bottom:14px}
.chaos{border-top:5px solid var(--bad)}
.solution{border-top:5px solid var(--ok)}
.box ul{list-style:none}
.box li{padding:9px 0 9px 28px;position:relative;border-bottom:1px dashed var(--line)}
.box li:last-child{border-bottom:none}
.chaos li:before{content:"✕";position:absolute;left:0;color:var(--bad);font-weight:700}
.solution li:before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:700}
/* Capabilities */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.cap{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px;transition:.25s}
.cap:hover{transform:translateY(-5px);box-shadow:0 12px 28px rgba(37,99,235,.15);border-color:var(--brand)}
.cap .ic{font-size:2rem;margin-bottom:10px}
.cap h3{margin-bottom:6px}
.cap p{color:var(--muted);font-size:.95rem}
/* Chat */
.chat{max-width:640px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(20,33,61,.08)}
.chat-head{background:var(--brand);color:#fff;padding:14px 20px;font-weight:600;display:flex;align-items:center;gap:10px}
.dot{width:10px;height:10px;border-radius:50%;background:#4ade80}
.chat-body{height:330px;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px;background:#fbfcff}
.msg{max-width:84%;padding:11px 15px;border-radius:14px;font-size:.95rem;animation:pop .3s ease}
@keyframes pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.user{align-self:flex-end;background:var(--brand);color:#fff;border-bottom-right-radius:4px}
.bot{align-self:flex-start;background:#eef2f9;border-bottom-left-radius:4px}
.hint{color:var(--muted);text-align:center;font-size:.9rem;margin:auto}
.typing{display:flex;gap:5px;padding:14px 16px}
.typing span{width:8px;height:8px;background:#9aa8bf;border-radius:50%;animation:blink 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:.25}40%{opacity:1}}
.btns{display:flex;flex-wrap:wrap;gap:10px;padding:16px;border-top:1px solid var(--line);background:#fff}
.btns button{flex:1 1 180px;padding:11px 14px;border:1.5px solid var(--brand);background:#fff;color:var(--brand);border-radius:10px;font-weight:600;cursor:pointer;font-size:.9rem;transition:.2s}
.btns button:hover:not(:disabled){background:var(--brand);color:#fff}
.btns button:disabled{opacity:.5;cursor:not-allowed}
/* Footer */
footer{background:var(--ink);color:#fff;text-align:center;padding:56px 20px 32px}
footer h2{color:#fff}
footer p{color:#b7c3d8}
.cta{display:inline-block;margin:22px 0 34px;padding:16px 38px;background:linear-gradient(135deg,var(--brand),#3b82f6);color:#fff;text-decoration:none;font-weight:700;font-size:1.1rem;border-radius:999px;box-shadow:0 8px 24px rgba(59,130,246,.5);transition:.2s}
.cta:hover{transform:translateY(-3px) scale(1.03)}
.credit{font-size:.85rem;color:#8a98b3;border-top:1px solid #2a3a5e;padding-top:18px}
@media(max-width:760px){.grid2,.grid3{grid-template-columns:1fr}.hero h1{font-size:2.2rem}section{padding:40px 0}}
</style>
</head>
<body>

<!-- 1. HERO -->
<header class="hero">
  <div class="wrap">
    <div class="avatar">👁️</div>
    <h1>PIPZ</h1>
    <div class="badge">🟢 Status: Active &amp; Ready 24/7</div>
    <p class="tagline">Asisten digital yang menjawab pertanyaan pasien serta merapikan jadwal dan diskusi, supaya praktik Anda berjalan lebih tenang.</p>
  </div>
</header>

<!-- 2. PROBLEM & SOLUTION -->
<section>
  <div class="wrap">
    <h2>Dari Kacau Menjadi Terkendali</h2>
    <p class="sub">Masalah yang sering muncul di praktik harian, dan cara PIPZ menanganinya.</p>
    <div class="grid2">
      <div class="box chaos">
        <h3>😵 The Chaos</h3>
        <ul>
          <li>Jadwal sering hampir bentrok</li>
          <li>Pertanyaan yang sama terus berulang dari pasien</li>
          <li>Lupa atau bingung mengambil keputusan jika ada kasus mata yang tidak rutin</li>
        </ul>
      </div>
      <div class="box solution">
        <h3>✨ The Solution</h3>
        <ul>
          <li>Jadwal diatur otomatis dan konflik terdeteksi lebih awal</li>
          <li>Draft balasan siap pakai untuk pertanyaan pasien yang berulang</li>
          <li>Kasus tidak rutin ditandai dan diserahkan ke dokter lewat Human-in-the-Loop</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 3. CORE CAPABILITIES -->
<section style="background:#fff">
  <div class="wrap">
    <h2>Kemampuan Utama</h2>
    <p class="sub">Terhubung dengan tools yang sudah Anda pakai setiap hari.</p>
    <div class="grid3">
      <div class="cap">
        <div class="ic">📅</div>
        <h3>Atur Jadwal Otomatis</h3>
        <p>Terhubung ke Google Calendar atau Apple Calendar untuk menyusun jadwal dan memberi peringatan sebelum terjadi bentrok.</p>
      </div>
      <div class="cap">
        <div class="ic">✉️</div>
        <h3>Draft Balasan Pasien</h3>
        <p>Membuat draft balasan lewat Gmail dengan rujukan materi dari Google Drive, lalu menunggu persetujuan Anda sebelum dikirim.</p>
      </div>
      <div class="cap">
        <div class="ic">🧑‍⚕️</div>
        <h3>Human-in-the-Loop</h3>
        <p>Untuk kasus tidak rutin, PIPZ tidak memutuskan sendiri. Kasus dirangkum dan diteruskan agar dokter yang memutuskan.</p>
      </div>
    </div>
  </div>
</section>

<!-- 4. INTERACTIVE SIMULATION -->
<section>
  <div class="wrap">
    <h2>Coba Simulasinya</h2>
    <p class="sub">Klik salah satu skenario untuk melihat PIPZ bekerja.</p>
    <div class="chat">
      <div class="chat-head"><span class="dot"></span> PIPZ · Asisten Praktik Mata</div>
      <div class="chat-body" id="chat"><p class="hint" id="hint">Pilih skenario di bawah untuk memulai 👇</p></div>
      <div class="btns">
        <button onclick="play(0)">📅 Jadwal Bentrok</button>
        <button onclick="play(1)">💬 Pertanyaan Pasien</button>
        <button onclick="play(2)">🚨 Kasus Tidak Rutin</button>
      </div>
    </div>
  </div>
</section>

<!-- 5. FOOTER & CTA -->
<footer>
  <h2>Siap Punya Karyawan Digital Sendiri?</h2>
  <p>Hubungi kami lewat email untuk diskusi atau demo PIPZ.</p>
  <a class="cta" href="mailto:zurumaxis@gmail.com?subject=Tertarik%20dengan%20PIPZ">📩 Kirim Email ke Kami</a>
  <p class="credit">Built with AI · AI Builder Bootcamp Showcase</p>
</footer>

<script>
const scenarios=[
 [{r:"user",t:"Ada dua pasien yang dijadwalkan jam 10.00 hari Kamis. Tolong cek."},
  {r:"bot",t:"Saya menemukan 2 janji yang bentrok di Google Calendar: Ibu Sari (kontrol glaukoma) dan Pak Budi (cek refraksi), keduanya pukul 10.00."},
  {r:"bot",t:"Usulan: pindahkan Pak Budi ke 10.30, karena slot itu kosong. Setujui perubahan ini? ✅ Menunggu konfirmasi Anda."}],
 [{r:"user",t:"Pasien bertanya: 'Dok, setelah operasi katarak boleh keramas kapan?'"},
  {r:"bot",t:"Pertanyaan ini sudah sering masuk. Saya sudah menyusun draft balasan berdasarkan panduan pasca operasi di Google Drive."},
  {r:"bot",t:"📝 Draft siap di Gmail: 'Selamat siang, untuk keramas sebaiknya mengikuti arahan pasca operasi dari dokter. Detailnya akan kami kirim.' Mau dikirim atau diedit dulu?"}],
 [{r:"user",t:"Ada pasien dengan keluhan mata merah mendadak disertai penurunan penglihatan, belum pernah kontrol."},
  {r:"bot",t:"⚠️ Ini kasus tidak rutin, jadi saya tidak mengambil keputusan sendiri (Human-in-the-Loop)."},
  {r:"bot",t:"Ringkasan kasus sudah saya siapkan dan ditandai prioritas untuk Dokter. Slot terdekat juga sudah saya tahan di kalender sampai ada keputusan."}]
];
const chat=document.getElementById("chat"),btns=document.querySelectorAll(".btns button");
const wait=ms=>new Promise(r=>setTimeout(r,ms));
function add(role,text){
  const d=document.createElement("div");
  d.className="msg "+role;d.textContent=text;
  chat.appendChild(d);chat.scrollTop=chat.scrollHeight;
}
function typing(){
  const d=document.createElement("div");
  d.className="msg bot typing";
  d.innerHTML="<span></span><span></span><span></span>";
  chat.appendChild(d);chat.scrollTop=chat.scrollHeight;
  return d;
}
async function play(i){
  btns.forEach(b=>b.disabled=true);
  chat.innerHTML="";
  for(const m of scenarios[i]){
    if(m.r==="user"){await wait(300);add("user",m.t);}
    else{
      const t=typing();
      await wait(1300);
      t.remove();
      add("bot",m.t);
    }
  }
  btns.forEach(b=>b.disabled=false);
}
</script>
</body>
</html>
